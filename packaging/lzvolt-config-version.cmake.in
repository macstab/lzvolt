# Version check for `find_package(lzvolt <version>)`.
#
# Compatible across a major version and no further: the stream format is
# stable, the API follows semver, so 1.x accepts any 1.y with y >= the request
# and rejects 2.x outright.
set(PACKAGE_VERSION "@VERSION@")

if(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  string(REGEX MATCH "^[0-9]+" _want_major "${PACKAGE_FIND_VERSION}")
  string(REGEX MATCH "^[0-9]+" _have_major "${PACKAGE_VERSION}")
  if(_want_major STREQUAL _have_major)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
      set(PACKAGE_VERSION_EXACT TRUE)
    endif()
  else()
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
  endif()
endif()
