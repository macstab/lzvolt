# A released glibc shared object, built where the oldest supported glibc is.
#
# Debian 12 (glibc 2.36) rather than the newest available: a shared object
# links against the glibc it was built on and runs on that version or newer,
# so building on something current would quietly exclude every older host.
FROM rust:1.85-bookworm AS build

ARG TARGET=x86_64-unknown-linux-gnu

WORKDIR /src

# No apt step. The assembly goes through the C preprocessor, so a C toolchain
# is needed -- and the official Rust images are built on buildpack-deps, which
# already has one. Installing build-essential on top of that fetched nothing
# and cost a network round trip, and it broke the build outright under QEMU,
# where gpg verification fails and apt refuses the repository.

RUN rustup target add "$TARGET"

# Manifests first, so a source-only change does not refetch the index.
COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY asm ./asm
COPY build.rs ./
COPY include ./include
# Cargo parses the whole manifest before it builds anything, and this
# one declares example and bench targets. Without their sources the
# manifest does not parse, so the build fails before it starts.
COPY examples ./examples
COPY benches ./benches

RUN cargo build --release --target "$TARGET" \
 && mkdir -p /out \
 && cp "target/$TARGET/release/liblzvolt.so" /out/ \
 && cp "target/$TARGET/release/liblzvolt.a"  /out/

# Prove it loads and resolves before it is called a release artifact. A
# shared object that builds but will not link is a worse outcome than a
# failed build, because it fails at the user instead of here.
RUN echo 'int main(void){return 0;}' > /tmp/t.c \
 && gcc /tmp/t.c -L/out -llzvolt -o /tmp/t \
 && ldd /out/liblzvolt.so

# Exported with `--output type=local`, so the artifacts land at the root
# of the export rather than inside it. Nothing is ever run from this
# image -- `docker create` cannot instantiate a scratch image with no
# command, which is how the first version of this failed.
FROM scratch
COPY --from=build /out/ /
