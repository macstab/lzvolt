/target
**/*.rs.bk
*.pdb

# Criterion writes results here; benchmark output is reproduced, not committed.
/target/criterion

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Local perf captures
perf.data
perf.data.old
*.svg.tmp
flamegraph.svg

# Measurements belong to the machine that took them. The report script writes
# here by default; the pattern catches the explicitly named files CI produces,
# in case the same command is ever run by hand.
/bench-results/
/packer-report*.txt
/dist/

# Fuzzing. The corpus is regenerated from docs/vectors.txt by fuzz/seed.py and
# then grown by the run, so committing it would be committing a cache. The
# artifacts directory only ever holds reproducers for a crash -- if one turns
# up it belongs in a test in src/format.rs, not here.
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/Cargo.lock
